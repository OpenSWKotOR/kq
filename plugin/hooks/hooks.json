{
  "description": "Inject kq CLI contract at session start so agents do not invent flags or extract archives.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-context.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
